<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Permite ejecutar con .NET 9 instalado si no está el runtime de .NET 8 -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- Solo por los contratos (DTO) que intercambia con la API; el cliente web no usa los servicios ni el dominio -->
    <ProjectReference Include="..\VillaSalud.Application\VillaSalud.Application.csproj" />
  </ItemGroup>

</Project>
