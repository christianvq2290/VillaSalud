@{
    ViewData["Title"] = "Error";
}
<div class="panel text-center py-5">
    <h1 class="titulo-pagina">No se pudo completar la operación</h1>
    <p class="subtitulo">@(ViewData["Mensaje"] ?? "Ocurrió un error inesperado.")</p>
    <a class="btn btn-primario" asp-controller="Inicio" asp-action="Index">Volver al inicio</a>
</div>
