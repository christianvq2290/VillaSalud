@model List<MedicoDto>
@{
    ViewData["Title"] = "Médicos";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="titulo-pagina mb-0">Médicos</h1>
    <a class="btn btn-primario" asp-action="Editar">Nuevo médico</a>
</div>
<div class="panel p-0">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Colegiatura</th><th>Médico</th><th>Especialidad</th><th>Contacto</th><th>Estado</th><th></th></tr></thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.CodigoColegiatura</td>
                        <td class="fw-semibold">@m.NombreCompleto</td>
                        <td>@m.Especialidad</td>
                        <td>@m.Telefono @(string.IsNullOrEmpty(m.Email) ? "" : "· " + m.Email)</td>
                        <td>@(m.Estado ? "Activo" : "Inactivo")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Horarios" asp-route-id="@m.IdMedico">Horarios</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@m.IdMedico">Editar</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-secondary py-4">No hay médicos registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
