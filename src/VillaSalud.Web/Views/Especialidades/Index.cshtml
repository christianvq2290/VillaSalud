@model List<EspecialidadDto>
@{
    ViewData["Title"] = "Especialidades";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="titulo-pagina mb-0">Especialidades</h1>
    <a class="btn btn-primario" asp-action="Editar">Nueva especialidad</a>
</div>
<div class="panel p-0">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Nombre</th><th></th></tr></thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="fw-semibold">@e.Nombre</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@e.IdEspecialidad">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@e.IdEspecialidad" method="post" class="d-inline" data-confirmar="¿Eliminar la especialidad @e.Nombre?">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="2" class="text-center text-secondary py-4">No hay especialidades registradas.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
