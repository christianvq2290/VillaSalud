@model List<ConsultorioDto>
@{
    ViewData["Title"] = "Consultorios";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="titulo-pagina mb-0">Consultorios</h1>
    <a class="btn btn-primario" asp-action="Editar">Nuevo consultorio</a>
</div>
<div class="panel p-0">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Sede</th><th>Número</th><th>Piso</th><th>Estado</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Sede</td>
                        <td class="fw-semibold">@c.Numero</td>
                        <td>@c.Piso</td>
                        <td>@(c.Estado ? "Activo" : "Inactivo")</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@c.IdConsultorio">Editar</a></td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">No hay consultorios registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
