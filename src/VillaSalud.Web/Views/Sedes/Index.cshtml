@model List<SedeDto>
@{
    ViewData["Title"] = "Sedes";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="titulo-pagina mb-0">Sedes</h1>
    <a class="btn btn-primario" asp-action="Editar">Nueva sede</a>
</div>
<div class="panel p-0">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Nombre</th><th>Dirección</th><th>Distrito</th><th>Estado</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-semibold">@s.Nombre</td>
                        <td>@s.Direccion</td>
                        <td>@s.Distrito</td>
                        <td>@(s.Estado ? "Activa" : "Inactiva")</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@s.IdSede">Editar</a></td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">No hay sedes registradas.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
