<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Permite ejecutar con .NET 9 instalado si no está el runtime de .NET 8 -->
    <RollForward>Major</RollForward>
    <UserSecretsId>villasalud-api-7f3c2a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.*" />
    <PackageReference Include="Azure.Identity" Version="1.*" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VillaSalud.Application\VillaSalud.Application.csproj" />
    <ProjectReference Include="..\VillaSalud.Infrastructure\VillaSalud.Infrastructure.csproj" />
  </ItemGroup>

</Project>
